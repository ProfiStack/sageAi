{
  "name": "naimat",
  "version": "0.0.1",
  "main": "server.js",
  "scripts": {
    "migrate": "cd src && sequelize db:migrate",
    "migrate:undo": "cd src && sequelize db:migrate:undo:all",
    "seed": "cd src && sequelize db:seed:all",
    "seed:undo": "cd src && sequelize db:seed:undo:all",
    "start": "cd src && yarn nodemon server.js",
    "setup": "cd src && NODE_ENV=test sequelize db:migrate",
    "teardown": "cd src && NODE_ENV=test sequelize db:migrate:undo:all",
    "test": "NODE_ENV=test yarn teardown && yarn setup && jest --colors --detectOpenHandles"
  },
  "author": "Hassan khan",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.673.0",
    "@babel/runtime": "^7.8.0",
    "aws-sdk": "^2.1691.0",
    "bcrypt": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^8.2.0",
    "express": "^4.21.1",
    "express-jwt": "^6.0.0",
    "express-rate-limit": "^5.2.3",
    "http-status": "^1.5.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^6.4.17",
    "nodemon": "^1.18.10",
    "pg": "^8.5.1",
    "pg-hstore": "^2.3.3",
    "require-all": "^3.0.0",
    "sequelize": "^6.5.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^7.19.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.3.1",
    "nodemon": "^2.0.22",
    "prettier": "^2.2.1",
    "sequelize-cli": "^6.2.0",
    "update-changelog": "^1.0.2"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node"
  }
}
